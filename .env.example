OUTPUT_FILE=directory-structure
TAB=│   
BRANCH=├── 
LAST_BRANCH=└── 
EXCLUDE_FOLDERS=.git,node_modules,dist,build,----------
EXCLUDE_FILES=Desktop.ini,*.tmp,*.log,*.bak,*.swp
INPUT_DIR=.
FORMAT=txt
MAX_DEPTH=10
SHOW_HIDDEN=false
SHOW_SIZE=false
SHOW_PERMISSIONS=false
SHOW_LAST_MODIFIED=false
INCLUDE_EXTENSIONS=
EXCLUDE_PATTERNS=
OUTPUT_PATH=./output
CREATE_SUBFOLDER=false
VERBOSE=true
COLOR_OUTPUT=false
MAX_FILE_SIZE=10485760
IGNORE_LIST=.DS_Store,Thumbs.db
LOGGING=false
RESPECT_GITIGNORE=false
HEADERS=true
USE_EMOJIS=true
EMOJI_FOLDER=📁
EMOJI_FILE=📄
