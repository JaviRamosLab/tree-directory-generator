    "tree",
    "generator",
    "filesystem",
    "visualizer",
    "structure",
    "folder",
    "explorer",
    "cli",
    "directory-structure",
    "tree-view",
    "file-system-traversal"
  ],
  "homepage": "https://github.com/JaviRamosLab/tree-directory-generator#readme",
  "bugs": {
    "url": "https://github.com/JaviRamosLab/tree-directory-generator/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JaviRamosLab/tree-directory-generator.git"
  },
  "funding": [
    {
      "type": "individual",
      "url": "https://javiramoslab.com/funding"
