{
  "name": "directory-tree-generator",
  "version": "1.0.0",
  "description": "A utility to generate visual representations of directory structures as filetipes (.TREE, .TXT, .JSON)",
  "main": "src/treeGenerator.js",
  "bin": {
    "treegen": "./src/treeGenerator.js",
    "directory-tree-generator": "./src/treeGenerator.js"
  },
  "scripts": {
    "start": "node src/treeGenerator.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "node src/treeGenerator.js",
    "build": "echo \"Build completed\"",
    "lint": "echo \"No linting configured yet\"",
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "lint:fix": "biome lint --write .",
    "clean": "rimraf dist coverage .nyc_output",
    "clean:deps": "rimraf node_modules package-lock.json",
    "install:clean": "npm run clean:deps && npm install",
    "security": "npm audit --audit-level high",
    "security:fix": "npm audit fix",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run"
  },
  "keywords": [
    "directory",
    "tree",
    "generator",
    "filesystem",
    "visualizer",
    "structure",
    "folder",
    "explorer",
    "cli",
    "directory-structure",
    "tree-view",
    "file-system-traversal"
  ],
  "homepage": "https://github.com/JaviRamosLab/tree-generator#readme",
