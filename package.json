  },
  "main": "src/treeGenerator.js",
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "audit": "npm audit",
    "build": "echo \"Build completed\"",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "clean": "rimraf dist coverage .nyc_output",
    "clean:deps": "rimraf node_modules package-lock.json",
    "dev": "node --watch src/treeGenerator.js",
    "format": "biome format --write .",
    "format:check": "biome format --check .",
    "install:clean": "npm run clean:deps && npm install",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint-ci": "biome ci .",
    "pack": "npm pack --pack-destination=./dist/",
    "prepare": "husky",
    "publish": "npm publish",
    "release": "semantic-release",
    "release:dry-run": "semantic-release --dry-run",
    "security": "npm audit --audit-level high",
    "security:fix": "npm audit fix",
    "start": "node --watch app.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "gitignore-parser": "^0.0.2",
    "minimatch": "^10.2.6",
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@commitlint/cz-commitlint": "^20.1.0",
    "@semantic-release/github": "^10.0.0",
    "@semantic-release/npm": "^12.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "semantic-release": "^24.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "docs": "https://javiramoslab.com/projects/tree-directory-generator/docs",
  "readmeFilename": "README.md",
  "security": {
    "contact": "co2mm.esperanto@gmail.com",
    "policy": "https://github.com/javiramoslab/tree-directory-generator/security/policy"
  }
}
