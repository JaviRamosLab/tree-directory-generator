{
  "branches": [
    "main",
    "master"
  ],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          {
            "type": "feat",
            "release": "minor"
          },
          {
            "type": "fix",
            "release": "patch"
          },
          {
            "type": "perf",
            "release": "patch"
          },
          {
            "type": "docs",
            "release": "patch"
          },
          {
            "type": "style",
            "release": "patch"
          },
          {
            "type": "refactor",
            "release": "patch"
          },
          {
            "type": "test",
            "release": "patch"
          },
          {
            "type": "chore",
            "release": "patch"
          },
          {
            "type": "build",
            "release": "patch"
          },
          {
            "type": "ci",
            "release": "patch"
          }
        ],
        "parserOpts": {
          "noteKeywords": [
            "BREAKING CHANGE",
            "BREAKING CHANGES",
            "BREAKING"
          ]
        }
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          "**/*",
          "!node_modules/**",
          "!**/*.log",
          "!**/__tests__/**",
          "!**/test/**",
          "!**/tests/**",
          "!**/coverage/**",
          "!**/docs/**",
          "!**/.github/**",
          "!**/.vscode/**",
          "!**/scripts/**",
          "!**/*.sh",
          "!**/*.bat",
          "!**/config/**",
          "!**/.env*",
          "!**/.*",
          "!**/dist/**",
          "!**/build/**"
        ],
        "releasedLabels": [
          "Status: Released"
        ],
        "releasedIssues": true
      }
    ],
    [
      "@semantic-release/npm",
      {
        "pkgRoot": ".",
        "tarballDir": "dist"
      }
    ]
  ]
}